# ==============================================================================
# GroundCheck AI — Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the application:
#   cp .env.example .env
#
# DO NOT COMMIT .env WITH REAL SECRETS OR PRIVATE KEYS TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
# Environment mode: 'development', 'testing', or 'production'
ENVIRONMENT=production

# Application Version (synchronized across backend, manifest, and reports)
APP_VERSION=1.0.0

# Backend API server binding
API_HOST=0.0.0.0
API_PORT=8000

# Frontend public API destination URL
# In Development: http://localhost:8000
# In Production:  https://api.groundcheck.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 2. EXTERNAL AI & REASONING SERVICES
# ------------------------------------------------------------------------------
# Google Gemini API key used for document OCR assistance and claim extraction.
# If omitted or unconfigured, the system runs safely in deterministic fallback mode
# using explicit benchmark seeding and manual evidence workspace ingestion.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 3. PERSISTENT STORAGE & FILE SYSTEM
# ------------------------------------------------------------------------------
# Root storage directory for evidence items, uploaded PDFs, verification snapshots,
# and audit trails. In Docker/Production, mount a persistent volume to this path.
STORAGE_DIR=backend/uploads

# Maximum allowed file upload size in bytes (default: 52428800 = 50 MB)
MAX_UPLOAD_SIZE_BYTES=52428800

# ------------------------------------------------------------------------------
# 4. DATABASE & PERSISTENCE
# ------------------------------------------------------------------------------
# MongoDB connection URI (e.g. mongodb://localhost:27017/groundcheck_ai or mongodb+srv://...)
# If unconfigured, the system runs safely in local embedded persistence mode.
MONGODB_URI=
DATABASE_URL=sqlite:///./groundcheck.db

# ------------------------------------------------------------------------------
# 5. SECURITY, INTEGRITY & CORS
# ------------------------------------------------------------------------------
# Comma-separated list of allowed CORS origins for browser security.
# In Production, specify your exact frontend domain(s).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Secret key used for cryptographic HMAC package signing (64-char hex string)
# Generate via: python -c "import secrets; print(secrets.token_hex(32))"
GROUNDCHECK_SECRET_KEY=

# ------------------------------------------------------------------------------
# 6. LOGGING & OBSERVABILITY
# ------------------------------------------------------------------------------
# Logging level: 'DEBUG', 'INFO', 'WARNING', 'ERROR'
LOG_LEVEL=INFO

# Enable JSON-formatted structured production audit logging
STRUCTURED_LOGGING=true

# ==============================================================================
# ENVIRONMENT PROFILES SUMMARY:
#
# Profile A: Development (Local Machine)
#   ENVIRONMENT=development
#   NEXT_PUBLIC_API_URL=http://localhost:8000
#   STORAGE_DIR=backend/uploads
#   LOG_LEVEL=DEBUG
#
# Profile B: Testing / CI Pipeline
#   ENVIRONMENT=testing
#   STORAGE_DIR=backend/tests/fixtures/uploads_test
#   LOG_LEVEL=WARNING
#
# Profile C: Production Deployment (Docker / Cloud)
#   ENVIRONMENT=production
#   NEXT_PUBLIC_API_URL=https://api.groundcheck.internal
#   STORAGE_DIR=/data/groundcheck/uploads
#   CORS_ORIGINS=https://groundcheck.internal
#   LOG_LEVEL=INFO
# ==============================================================================
